---
// src/pages/timer/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import timerScript from "../../scripts/timer.js?url";
---

<BaseLayout>
    <div slot="head">
        <title>TickTock | Timer
        </title>
    </div>

    <div slot="header-content">
        <div id="event-label"></div>
    </div>

    <div slot="custom-menu">
        <div class="timer-adding-container menu-item" id="timer-adding-container" style="margin-top: 10px;">
            <div class="timer-editor">
                <div class="timer-unit-box" id="hour-unit-box">
                    <button class="number-up arrow" id="hour-number-up">
                        <span class="material-symbols-outlined">arrow_drop_up</span>
                    </button>
                    <input class="timer-number-input no-arrow" id="hour-number-input" 
                        type="number" min="0" max="59" placeholder="00"
                        oninput="if(value>59)value=59; if(value.length>2)value=value.slice(0,2);"
                        onblur="if(value!=='')value=value.padStart(2,'0');">
                    <button class="number-down arrow" id="hour-number-down">
                        <span class="material-symbols-outlined">arrow_drop_down</span>
                    </button>
                </div>
                <div class="timer-unit-box" id="hour-unit-box">
                    <button class="number-up arrow" id="hour-number-up">
                        <span class="material-symbols-outlined">arrow_drop_up</span>
                    </button>
                    <input class="timer-number-input no-arrow" id="hour-number-input" 
                        type="number" min="0" max="59" placeholder="00"
                        oninput="if(value>59)value=59; if(value.length>2)value=value.slice(0,2);"
                        onblur="if(value!=='')value=value.padStart(2,'0');">
                    <button class="number-down arrow" id="hour-number-down">
                        <span class="material-symbols-outlined">arrow_drop_down</span>
                    </button>
                </div>
                <div class="timer-unit-box" id="hour-unit-box">
                    <button class="number-up arrow" id="hour-number-up">
                        <span class="material-symbols-outlined">arrow_drop_up</span>
                    </button>
                    <input class="timer-number-input no-arrow" id="hour-number-input" 
                        type="number" min="0" max="59" placeholder="00"
                        oninput="if(value>59)value=59; if(value.length>2)value=value.slice(0,2);"
                        onblur="if(value!=='')value=value.padStart(2,'0');">
                    <button class="number-down arrow" id="hour-number-down">
                        <span class="material-symbols-outlined">arrow_drop_down</span>
                    </button>
                </div>
            </div>
            
            <div class="timer-adding-action-btn">
                <button>
                    <span class="material-symbols-outlined">add</span>
                </button>
            </div>
        </div>
        
    </div>

    <div slot="main-content" class="countdown-container">
        <section>
            <div class="time-box"><div id="years">00</div><span>years</span></div>
            <div class="time-box"><div id="months">00</div><span>months</span></div>
            <div class="time-box"><div id="days">00</div><span>days</span></div>
            <div class="time-box"><div id="hours">00</div><span>hours</span></div>
            <div class="time-box"><div id="minutes">00</div><span>minutes</span></div>
            <div class="time-box"><div id="seconds">00</div><span>seconds</span></div>
        </section>
    </div>

    <div slot="footer-content">
        <div id="target-label"></div>
    </div>

    <script
        slot="foot-script"
        type="module"
        src={timerScript}>
    </script>
</BaseLayout>

<style>
section
{
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
    max-width: 1200px;
    width: 100%;
}

/* header header header header header header header header header header */

#event-label
{
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    color: var(--text-heading);
    font-size: 3rem;
    margin-top: 15px;
    margin-bottom: clamp(5px, 2vh, 30px);
    padding: 0 10px;
}

/* aside aside aside aside aside aside aside aside aside aside */

.timer-adding-container
{
    display: flex;
    gap: 10px;
    flex-direction: row;

    align-items: center;
}

.timer-editor
{
    display: flex;
    gap: 10px;
    flex-direction: row;
}

.timer-unit-box
{
    display: flex;
    gap: 10px;
    flex-direction: column;

    align-items: center;
}

.timer-number-input
{
    
    width: 2rem;
    padding: 5px;
    border-radius: 8px;

    font-size: 1.2rem;
    font-family: inherit;
    text-align: center;

    outline: none;

    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    color: var(--text-heading);
}

.no-arrow::-webkit-inner-spin-button,
.no-arrow::-webkit-outer-spin-button
{
    -webkit-appearance: none;
    margin: 0;
}

.arrow
{
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
    
    background: var(--button-secondary-bg);
    color: var(--text-secondary);
    
    border-radius: 12px;
    border: none;
    cursor: pointer;

    height: 26px;
    width: 45px;
}

.arrow:hover
{
    color: var(--text-body);
}

.arrow>span
{
    font-size: 2rem;
}

.timer-adding-action-btn>button
{
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
    
    background: var(--button-secondary-bg);
    color: var(--text-secondary);
    
    border-radius: 12px;
    border: none;
    cursor: pointer;

    height: 45px;
    width: 45px;
}

.timer-adding-action-btn>button:hover
{
    color: var(--text-body);
}

.timer-adding-action-btn>button>span
{
    font-size: 2rem;
}

.mode-btn-item
{
    flex: 1;
    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    border-radius: 8px;
    color: var(--text-secondary);
    padding: 8px;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
}

.mode-btn-item:hover
{
    background: var(--component-bg-hover);
    border-color: var(--border-hover);
    color: var(--text-heading);
}

.mode-btn-item.active
{
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: var(--accent-contract-text);
    font-weight: bold;
}

.menu-item
{
    margin-top: 15px;
    gap: 10px;
}

.menu-item label
{
    font-size: 0.9rem;
    color: var(--text-secondary);
}

#date-input, #title-input
{
    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    border-radius: 8px;
    color: var(--text-heading);
    padding: 10px;
    font-size: 1rem;
    font-family: inherit;
    outline: none;
}

/* main main main main main main main main main main */

.time-box
{
    background: var(--component-bg-standard);
    padding: 15px 20px;
    border-radius: 30px;
    text-align: center;
    min-width: 100px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.time-box.mode-single
{
    min-width: 280px;
    width: auto;
    padding: 25px 30px;
}

/* 數字 */
.time-box div
{
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--accent-color);

    width: max-content;
    /* 新增：強制數字等寬，防止字元縮放導致邊框抖動 */
    font-variant-numeric: tabular-nums;
}

.time-box.mode-single div
{
    font-size: 3.5rem;
    letter-spacing: 0.8rem;
}

/* 單位 */
.time-box span
{
    font-size: 0.8rem;
    color: var(--text-secondary);
    display: block;
    margin: 5px;
    width: 55px;
}

.time-box.mode-single span
{
    font-size: 1.5rem;
}

/* footer footer footer footer footer footer footer footer footer footer */

#target-label
{
    color: var(--text-secondary);
    align-items: center;
    font-size: 1rem;
    font-weight: bold;

    display: block;      /* 讓 margin 作用 */
    text-align: center;  /* 文字置中 */
    margin-top: clamp(15px, 3vh, 40px);
    width: 100%;         /* 強制換行，推開到倒數方塊下方 */
}

/* on moblie */

@media (max-width: 600px) 
{
    section
    {
        gap: 10px;
    }

    .time-box
    {
        padding: 10px 5px;
        border-radius: 15px;
    }

    .time-box div 
    {
        font-size: 1.6rem;
    }
    
    .time-box.mode-single
    {
        padding: 5px 15px;
    }
    
    .time-box.mode-single div
    {
        letter-spacing: 0.4rem;
    }

    .time-box.mode-single span
    {
        margin-top: -10px;
    }

}
</style>