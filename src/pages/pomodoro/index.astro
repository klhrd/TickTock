---
// src/pages/pomodoro/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import pomodoroScript from "../../scripts/pomodoro.js?url";
---

<BaseLayout>
    <div slot="head">
        <title>TickTock | Pomodoro Timer</title>
    </div>

    <div slot="header-content">
        <div class="header-title">
            Pomodoro Timer
        </div>
    </div>

    <div slot="custom-menu">
        <div class="menu-item">
            <label for="cycles-input">Total Cycles</label>
            <input type="number" id="cycles-input" min="1" max="12" value="4">
        </div>

        <div class="menu-item">
            <label>Estimated Time</label>
            <span id="estimated-time-display">2h 00m</span>
        </div>

        <hr class="menu-divider" />

        <button id="menu-start-btn" class="menu-action-btn">
            <span class="material-symbols-outlined">play_arrow</span> Start Session
        </button>
    </div>

    <div slot="main-content" class="pomodoro-container">
        <div class="phase-indicator" id="phase-label">Focus Session</div>
        <div class="timer-display" id="timer-display">25:00</div>

        <div class="timeline-container">
            <div class="timeline-track" id="timeline-track">
                <div class="segment work-segment" id="work-segment">
                    <span class="segment-label">Work</span>
                </div>
                <div class="segment break-segment" id="break-segment">
                    <span class="segment-label">Break</span>
                </div>
                <div class="timeline-pin" id="timeline-pin"></div>
            </div>
            <div class="timeline-markers">
                <span>0m</span>
                <span id="work-end-mark">25m</span>
                <span id="total-end-mark">30m</span>
            </div>
        </div>

        <div class="control-group">
            <button id="start-btn" class="action-btn primary">Start</button>
            <button id="pause-btn" class="action-btn secondary" disabled>Pause</button>
            <button id="reset-btn" class="action-btn ghost">Reset</button>
            
        </div>
    </div>

    <div slot="footer-content">

    </div>

    <script
        slot="foot-script"
        type="module"
        src={pomodoroScript}>
    </script>
</BaseLayout>

<style>
section
{
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
    max-width: 1200px;
    width: 100%;
}

/* header header header header header header header header header header */

#event-label
{
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    color: var(--text-heading);
    font-size: 3rem;
    margin-top: 15px;
    margin-bottom: clamp(5px, 2vh, 30px);
    padding: 0 10px;
}

/* aside aside aside aside aside aside aside aside aside aside */

.menu-item
{
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.menu-item label
{
    font-weight: 500;
}

.menu-item input[type="number"]
{
    width: 60px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-standard);
    background: var(--component-bg-standard);
    color: var(--text-heading);
    font-size: 0.9rem;
    font-family: inherit;
    text-align: center;
    outline: none;
    transition: border-color 0.2s ease;
}

.menu-item input[type="number"]:focus
{
    border-color: var(--accent-color);
}

#cycles-input
{
    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    border-radius: 8px;
    color: var(--text-heading);
    padding: 10px;
    font-size: 1rem;
    font-family: inherit;
    outline: none;
}

.menu-action-btn
{
    display: flex;
    align-items: center;
    width: 100%;
    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    border-radius: 8px;
    color: var(--text-secondary);
    padding: 8px;
    margin: 10px 0px;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
}

.menu-action-btn:hover
{
    background: var(--component-bg-hover);
    border-color: var(--border-hover);
    color: var(--text-heading);
}

/* main main main main main main main main main main */

.pomodoro-container
{
    width: 90svw;
    margin: 40px auto;
    padding: 32px 28px;
    background: var(--component-bg-standard);
    border: 1px solid var(--border-standard);
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
}

.phase-indicator
{
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent-color);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.timer-display
{
    font-size: 4.5rem;
    font-weight: 700;
    font-family: monospace;
    font-variant-numeric: tabular-nums;
    color: var(--text-heading);
    line-height: 1;
    margin: 12px 0 24px 0;
    letter-spacing: 2px;
}

.timeline-container
{
    width: 100%;
    margin-bottom: 32px;
}

.timeline-track
{
    position: relative;
    display: flex;
    width: 100%;
    height: 18px;
    background: var(--button-secondary-bg);
    border-radius: 9px;
    overflow: hidden;
    margin: 12px 0px 8px 0px;
    box-shadow: inset 0px 2px 4px rgba(0,0,0,0.15);
}

.segment
{
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition: flex 0.3s ease;
}

.segment-label
{
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    pointer-events: none;
    user-select: none;
}

.segment.work-segment
{
    background: var(--accent-color);
    color: var(--accent-contract-text);
    transition: flex 0.3s ease;
}

.segment.break-segment
{
    background: rgba(255,255,255,0.15);
    color: var(--text-secondary);
    transition: flex 0.3s ease;
}

.timeline-pin
{
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #ffffff;
    box-shadow: 0px 0px 8px rgba(255,255,255,0.8);
    transform: translateX(-50%);
    transition: left 0.1s linear;
    z-index: 2;
}

.timeline-markers
{
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: monospace;
    color: var(--text-secondary);
    padding: 0 2px;
}

.control-group
{
    display: flex;
    gap: 12px;
    width: 100%;
    justify-content: center;
}

.action-btn
{
    padding: 10px 24px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition-timing-function: all 0.2s ease;
    border: 1px solid transparent;
}

.action-btn.primary
{
    background: var(--accent-color);
    color: var(--accent-contract-text);
}

.action-btn.primary:hover
{
    opacity: 0.9;
    transform: translateY(-1px);
}

.action-btn.secondary
{
    background: var(--component-bg-hover);
    color: var(--text-heading);
    border-color: var(--border-standard);
}

.action-btn.secondary:hover:not(:disabled)
{
    border-color: var(--border-hover);
}

.action-btn.ghost
{
    background: transparent;
    color: var(--text-secondary);
}

.action-btn.ghost:hover
{
    color: var(--text-heading);
    background: rgba(255,255,255,0.05);
}

.action-btn:disabled
{
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
}


/* footer footer footer footer footer footer footer footer footer footer */

/* on moblie */

@media (max-width: 600px) 
{

}
</style>